# ==========================================================================
# Žitopromet — server rules for Apache / LiteSpeed shared hosting
# (Hostinger, cPanel hosts such as Adria Host). Upload next to index.html.
# If the host runs nginx instead, these rules must be translated — ask us.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) One canonical address: https://zitopromet.net (no www, always HTTPS).
#    If the site is later put behind Cloudflare or another proxy and this
#    causes a redirect loop, switch the first condition to
#    RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://zitopromet.net%{REQUEST_URI} [L,R=301]

# 2) The previous WordPress site used other URLs. Send the useful ones to the
#    matching section of the new home page (301 = permanent, keeps Google rankings).
#    [NE] keeps the "#" in the target unescaped.
RewriteRule ^kulture/?$                        /#kulture   [NE,R=301,L]
RewriteRule ^kontakt/?$                        /#kontakt   [NE,R=301,L]
RewriteRule ^about/?$                          /#o-nama    [NE,R=301,L]
RewriteRule ^services/?$                       /#sta-radimo [NE,R=301,L]
RewriteRule ^(clanci|blog|blog-grid-2)/?$      /#clanci    [NE,R=301,L]
RewriteRule ^category/poljoprivreda/?$         /#clanci    [NE,R=301,L]
# the three market-news posts from December 2018 (no equivalent on the new site)
RewriteRule ^20[0-9]{2}/[0-9]{2}/[0-9]{2}/[^/]+/?$ /#clanci [NE,R=301,L]

# 3) Demo pages that came with the old WordPress theme and never had real
#    content: tell Google they are gone for good (410) instead of leaving 404s.
RewriteRule ^(sample-page|home-2|home-3|home-shop|gallery-1|gallery-2|product-details|shop|cart|checkout|my-account)/?$ - [G,L]
RewriteRule ^(tag|product|product-category|author)/ - [G,L]
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|feed|comments/feed) - [G,L]
</IfModule>

# --- compression ---------------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# --- browser caching -----------------------------------------------------
# CSS/JS are not fingerprinted, so keep them short so edits show up quickly.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png  "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 month"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
ExpiresByType text/javascript "access plus 1 day"
</IfModule>

# --- security headers ----------------------------------------------------
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
# Turn HSTS on only after https://zitopromet.net has been checked on the live host:
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
